{:system/env              #profile {:dev  :dev
                                    :test :test
                                    :prod :prod}

 :server/http             {:port    #profile {:dev 3000
                                              :test 3006},
                           :host    #or [#env HTTP_HOST "localhost"]
                           :handler #ig/ref :handler/ring}

 :handler/ring            {:router               #ig/ref :router/core
                           :api-path             "/api"
                           :cookie-secret        #or [#env COOKIE_SECRET "GZNUKBWMXERQIUPN"]
                           ;; from ring.middleware.defaults. anti-forgery `false` by default because services may not require it
                           :site-defaults-config {:params    {:urlencoded true
                                                              :multipart  true
                                                              :nested     true
                                                              :keywordize true}
                                                  :cookies   true
                                                  :session   {:flash        true
                                                              :cookie-name  "submarket.dashboard"
                                                              :cookie-attrs {:max-age   86400
                                                                             :http-only true
                                                                             :same-site :strict}}
                                                  :security  {:anti-forgery         false
                                                              :xss-protection       {:enable? true,
                                                                                     :mode    :block}
                                                              :frame-options        :sameorigin
                                                              :content-type-options :nosniff}
                                                  :static    {:resources "public"}
                                                  :responses {:not-modified-responses true
                                                              :absolute-redirects     true
                                                              :content-types          true
                                                              :default-charset        "utf-8"}}}

 :reitit.routes/api       {:base-path "/api"
                           :env       #ig/ref :system/env}

 :reitit.routes/ui        {:base-path "",
                           :env       #ig/ref :system/env}

 :router/routes           {:routes #ig/refset :reitit/routes}

 :router/core             {:routes #ig/ref :router/routes
                           :env    #ig/ref :system/env}
 ;
 ;;:email-sender {}
 ;; Aero's #profile selects one branch rather than merging, so #profile around
 ;; the whole map would let a profile entry replace the connection details.
 ;; Profile the single flag instead.
 ;;
 ;; Tests and local development apply migrations at boot, so a fresh checkout
 ;; needs no separate migrate step. Production leaves this off: a schema change
 ;; there should be a deliberate deploy step, not a side effect of whichever
 ;; revision an instance happened to start on.
 :database.sql/connection {:port     5432
                           :user     "admin"
                           :dbtype   "postgresql"
                           :dbname   "sub_market_test"
                           :password "1234"
                           ;; Aero resolves #profile by selecting a single branch:
                           ;; (get branches profile (get branches :default)). With no
                           ;; :profile supplied it resolves :default, so prod and any
                           ;; unprofiled run both land on false.
                           :migrate? #profile {:dev true :test true :default false}}
 }


