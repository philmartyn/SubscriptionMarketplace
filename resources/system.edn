{:system/env              #profile {:dev  :dev
                                    :test :test
                                    :prod :prod}

 :server/http             {:port    #profile {:dev 3000
                                              :test 3006},
                           :host    #or [#env HTTP_HOST "localhost"]
                           :handler #ig/ref :handler/ring}

 :handler/ring            {:router               #ig/ref :router/core
                           :api-path             "/api"
                           ;; The session store is Postgres-backed, so the
                           ;; handler needs the connection. integrant resolves
                           ;; the ref, which also orders construction: the
                           ;; database exists before anything builds a handler.
                           :database             #ig/ref :database.sql/connection
                           :mailer               #ig/ref :auth/mailer
                           ;; Used to build the verification link the signup
                           ;; path asks the mailer to send.
                           :base-url             #or [#env BASE_URL "http://localhost:3000"]
                           ;; With no mailer wired yet, development gets a
                           ;; button that marks an account verified directly.
                           ;; It is a verification bypass, so it is off by
                           ;; default and prod never resolves it to true.
                           :dev-verify?          #profile {:dev true :test true :default false}
                           ;; Site defaults from ring.middleware.defaults.
                           :site-defaults-config {:params    {:urlencoded true
                                                              :multipart  true
                                                              :nested     true
                                                              :keywordize true}
                                                  :cookies   true
                                                  :session   {:flash        true
                                                              :cookie-name  "submarket.dashboard"
                                                              :cookie-attrs {:max-age   86400
                                                                             :http-only true
                                                                             :same-site :strict}}
                                                  ;; Unsafe methods must carry a CSRF token. Kept false
                                                  ;; while every route was read only, so that flipping
                                                  ;; it could not be mistaken for a fix to a broken form.
                                                  :security  {:anti-forgery         true
                                                              :xss-protection       {:enable? true,
                                                                                     :mode    :block}
                                                              :frame-options        :sameorigin
                                                              :content-type-options :nosniff}
                                                  :static    {:resources "public"}
                                                  :responses {:not-modified-responses true
                                                              :absolute-redirects     true
                                                              :content-types          true
                                                              :default-charset        "utf-8"}}}

 :auth/mailer             {:capture? #profile {:dev true :test true :default false}
                           ;; Production sends through Mailgun. The key is a
                           ;; domain sending key (send-only), read from the
                           ;; environment and never committed. Outside the
                           ;; capture profiles both key and domain are required
                           ;; and the component fails fast without them.
                           :api-key  #or [#env MAILGUN_API_KEY nil]
                           :domain   #or [#env MAILGUN_DOMAIN nil]
                           :from     #or [#env MAILGUN_FROM "SubMarket <verify@sandbox35c210fabdb84877a42940866a26cf36.mailgun.org>"]
                           :region   #or [#env MAILGUN_REGION "us"]}

 :reitit.routes/api       {:base-path "/api"
                           :env       #ig/ref :system/env}

 :reitit.routes/ui        {:base-path "",
                           :env       #ig/ref :system/env}

 :router/routes           {:routes #ig/refset :reitit/routes}

 :router/core             {:routes #ig/ref :router/routes
                           :env    #ig/ref :system/env}
 ;
 ;;:email-sender {}
 ;; Aero's #profile selects one branch rather than merging, so #profile around
 ;; the whole map would let a profile entry replace the connection details.
 ;; Profile the single flag instead.
 ;;
 ;; Tests and local development apply migrations at boot, so a fresh checkout
 ;; needs no separate migrate step. Production leaves this off: a schema change
 ;; there should be a deliberate deploy step, not a side effect of whichever
 ;; revision an instance happened to start on.
 :database.sql/connection {:port     5432
                           :user     "admin"
                           :dbtype   "postgresql"
                           :dbname   "sub_market_test"
                           :password "1234"
                           ;; Aero resolves #profile by selecting a single branch:
                           ;; (get branches profile (get branches :default)). With no
                           ;; :profile supplied it resolves :default, so prod and any
                           ;; unprofiled run both land on false.
                           :migrate? #profile {:dev true :test true :default false}}
 }


