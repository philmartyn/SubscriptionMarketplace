{:paths   ["src" "resources"]
 :deps    {org.clojure/clojure               {:mvn/version "1.12.0"}

           aero/aero                         {:mvn/version "1.1.6"}
           buddy/buddy-auth                  {:mvn/version "3.0.323"}
           buddy/buddy-core                  {:mvn/version "1.12.0-430"}
           buddy/buddy-sign                  {:mvn/version "3.6.1-359"}
           com.github.seancorfield/next.jdbc {:mvn/version "1.3.981"}
           com.github.seancorfield/honeysql  {:mvn/version "2.6.1270"}
           clj-http/clj-http                 {:mvn/version "3.13.0"}
           dev.weavejester/ragtime           {:mvn/version "0.11.0"}
           integrant/integrant               {:mvn/version "0.13.1"}
           metosin/reitit                    {:mvn/version "0.11.0"}
           metosin/jsonista                  {:mvn/version "0.3.13"}
           ;; Argon2id password hashing
           org.bouncycastle/bcprov-jdk18on    {:mvn/version "1.78.1"}
           org.postgresql/postgresql         {:mvn/version "42.7.7"}
           ;; Ring
           metosin/ring-http-response        {:mvn/version "0.9.3"}
           ring/ring-core                    {:mvn/version "1.15.5"}
           ring/ring-defaults                {:mvn/version "0.6.0"}

           ;; Logging
           ch.qos.logback/logback-classic     {:mvn/version "1.5.16"}
           org.clojure/tools.logging          {:mvn/version "1.3.0"}


           ;; Data coercion
           luminus-transit/luminus-transit   {:mvn/version "0.1.6"
                                              :exclusions  [com.cognitect/transit-clj]}
           metosin/muuntaja                  {:mvn/version "0.6.11"}

           ;; kit Libs
           io.github.kit-clj/kit-core        {:mvn/version "1.0.10"}
           io.github.kit-clj/kit-undertow    {:mvn/version "1.0.10"}
           hiccup/hiccup                     {:mvn/version "2.0.0"}

           ;; Telemetry. The API is a no-op stub unless the OpenTelemetry
           ;; Java agent is attached (see the :otel alias below), so it is
           ;; safe to ship always. Keep the version aligned with the SDK the
           ;; pinned agent targets, or the agent's API bridge is skipped and
           ;; custom instrumentation silently no-ops.
           io.opentelemetry/opentelemetry-api {:mvn/version "1.66.0"}
           }

 :aliases {:build {:deps       {io.github.clojure/tools.build {:mvn/version "0.9.6"}}
                   :ns-default build}

           :test  {:extra-deps  {criterium/criterium                  {:mvn/version "0.4.6"}
                                 expound/expound                      {:mvn/version "0.9.0"}
                                 integrant/repl                       {:mvn/version "0.3.3"}
                                 dev.weavejester/ragtime              {:mvn/version "0.11.0"}
                                 io.github.cognitect-labs/test-runner {:git/url "https://github.com/cognitect-labs/test-runner.git"
                                                                       :git/tag "v0.5.1"
                                                                       :git/sha "dfb30dd"}
                                 pjstadig/humane-test-output          {:mvn/version "0.11.0"}
                                 ring/ring-devel                      {:mvn/version "1.11.0"}
                                 ring/ring-mock                       {:mvn/version "0.4.0"}
                                 io.github.kit-clj/kit-generator      {:mvn/version "0.2.5"}
                                 org.clojure/tools.namespace          {:mvn/version "1.4.5"}
                                 peridot/peridot                      {:mvn/version "0.5.4"}
                                 org.clj-commons/byte-streams         {:mvn/version "0.3.4"}
                                 com.lambdaisland/classpath           {:mvn/version "0.5.48"}
                                 lambdaisland/kaocha                  {:mvn/version "1.91.1392"}}
                   :exec-fn     kaocha.runner/exec-fn
                   :extra-paths ["test/clj" "dev"]}

           :db    {:main-opts ["-m" "components.db.cli"]}

           :dev   {:extra-paths ["dev"]
                   :jvm-opts    ["-DSUB_MARKET_LOG_LEVEL=DEBUG"]
                   :extra-deps  {com.lambdaisland/classpath      {:mvn/version "0.5.48"}
                                 dev.weavejester/ragtime         {:mvn/version "0.11.0"}
                                 criterium/criterium             {:mvn/version "0.4.6"}
                                 expound/expound                 {:mvn/version "0.9.0"}
                                 integrant/repl                  {:mvn/version "0.3.3"}
                                 mvxcvi/cljstyle                 {:mvn/version "0.16.630"}
                                 pjstadig/humane-test-output     {:mvn/version "0.11.0"}
                                 ring/ring-devel                 {:mvn/version "1.14.2"}
                                 ring/ring-mock                  {:mvn/version "0.4.0"}
                                 io.github.kit-clj/kit-generator {:mvn/version "0.2.5"}
                                 org.clojure/tools.namespace     {:mvn/version "1.4.4"}}}

           :nrepl {:jvm-opts    ["-DSUB_MARKET_LOG_LEVEL=DEBUG"]
                    :extra-deps {nrepl/nrepl {:mvn/version "1.1.0"}}
                   :main-opts  ["-m" "nrepl.cmdline" "-i"]}

           ;; Attach the OpenTelemetry Java agent. Opt-in, never part of :dev or
           ;; :test: a missing agent jar in :dev would stop every JVM from
           ;; starting, and the test suite must run with no collector reachable.
           ;; Run with `clojure -M:dev:nrepl:otel` (or any alias plus :otel).
           ;;
           ;; Fetch the jar first: dev/observability/fetch-agent.sh
           ;; The agent's default OTLP endpoint is http://localhost:4318, which
           ;; is where the collector publishes; leave the endpoint unset so an
           ;; env var can point it at Grafana Cloud later.
           ;; The agent also instruments logs and would POST them to /v1/logs,
           ;; which the collector 404s (no logs pipeline yet - Loki is a later
           ;; pass). Turn that signal off so the only noise is real.
           :otel  {:jvm-opts ["-javaagent:dev/observability/opentelemetry-javaagent.jar"
                              "-Dotel.service.name=submarket"
                              "-Dotel.resource.attributes=deployment.environment=dev"
                              "-Dotel.logs.exporter=none"]}

           :check {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.13.0"}}
                   :main-opts    ["-m" "cljfmt.main" "check"]}

           :fix   {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.13.0"}}
                   :main-opts    ["-m" "cljfmt.main" "fix"]}

           }
 }